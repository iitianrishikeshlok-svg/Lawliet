# ==============================================================================
# "L" — Multimodal Floating AI HUD & Desktop Overlay Environment Config
# ==============================================================================

# Required: Google Gemini API Key (supports gemini-2.5-flash with multimodal vision & dynamic thinking budget)
# Get your free key at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# Default AI Model (Default: gemini-2.5-flash)
# Options: gemini-2.5-flash, gemini-1.5-pro, gemini-1.5-flash
VITE_GEMINI_MODEL=gemini-2.5-flash

# Default Thinking Budget Level (1 = Flash / 0 tokens, 2 = Balanced / 2048 tokens, 3 = Deep Reason / 16384 tokens)
VITE_DEFAULT_THINKING_LEVEL=2

# Default Aesthetic Theme
# Options: obsidian, noir, cyber, frost
VITE_DEFAULT_THEME=obsidian

# Audio Feedback Effects (true / false)
VITE_AUDIO_FEEDBACK=true
